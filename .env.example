# ─────────────────────────────────────────────────────────────────
# TestFortge — sample environment file
# Copy to `.env` and fill in real values for your deployment.
# ─────────────────────────────────────────────────────────────────

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to "1" while developing so an ephemeral key is minted automatically.
FLASK_DEBUG=1

# Set to "1" if the app runs behind HTTPS (production).
# Enables Secure cookies and strict CSRF SSL.
BEHIND_HTTPS=0

# ── HTTP Basic Auth gate (recommended when the app is reachable
#    beyond localhost — LAN, VPN, tunnel, or public deploy) ──
# When BOTH user and password are set every request (except the
# allow-listed paths below) requires `Authorization: Basic <b64>`.
# Leave them empty for purely-local development with no auth.
TESTFORTGE_BASIC_USER=
TESTFORTGE_BASIC_PASSWORD=
# Comma-separated list of paths/prefixes that bypass the gate.
# Default: /healthz,/readyz so liveness + readiness probes keep working.
# TESTFORTGE_BASIC_PUBLIC_PATHS=/healthz,/readyz

# ── Network bind (only consulted by `python app.py`; gunicorn /
#    docker-compose use their own bind config) ──
# 127.0.0.1 = loopback only (default, safest)
# 0.0.0.0   = expose on every network interface — REQUIRES
#             TESTFORTGE_BASIC_USER/PASSWORD to be set.
# TESTFORTGE_HOST=127.0.0.1

# ── Limits (all optional, defaults are sane) ──
# MAX_CONTENT_LENGTH=67108864          # 64 MB upload cap
# CHAT_MESSAGE_MAX_CHARS=4000
# CHAT_HISTORY_MAX_ENTRIES=40

# ── Tedgie AI chatbot (Anthropic Claude) ──
# Leave empty to run Tedgie in pure rule-based mode (no network calls).
# When set, Tedgie will use Claude for free-form questions and fall back
# to the rule-based dispatcher on any failure.
ANTHROPIC_API_KEY=
# Optional model override; default is claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=600

# ── Paths (all optional) ──
# UPLOAD_FOLDER=./uploads
# STORAGE_FOLDER=./storage
# SESSION_FILE_DIR=./flask_session

# ── Logging ──
# LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text                       # "text" for dev, "json" for containers

# ── Job queue (async /automation and /estimation endpoints) ──
# JOB_QUEUE_WORKERS=2                   # ThreadPoolExecutor width
# JOB_RETENTION_SECONDS=3600            # how long finished jobs stay queryable
# MAX_CONCURRENT_JOBS_PER_SESSION=3     # per-user concurrency cap, 429 on overflow

# ── Automation module (TS + Playwright + Allure) ──
# The shared secret a local or CI run presents to POST allure-results back
# to /automation/allure-results. UNSET MEANS THE ENDPOINT IS OFF — an
# unauthenticated ingest endpoint is one anyone can write run history into.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOMATION_INGEST_TOKEN=

# ── Docker compose / standalone ──
# TESTFORTGE_PORT=5000                  # host port to publish
