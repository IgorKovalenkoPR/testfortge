# ─────────────────────────────────────────────────────────────────
# TestFortge — sample environment file
# Copy to `.env` and fill in real values for your deployment.
# ─────────────────────────────────────────────────────────────────

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to "1" while developing so an ephemeral key is minted automatically.
FLASK_DEBUG=1

# Set to "1" if the app runs behind HTTPS (production).
# Enables Secure cookies and strict CSRF SSL.
BEHIND_HTTPS=0

# ── Limits (all optional, defaults are sane) ──
# MAX_CONTENT_LENGTH=67108864          # 64 MB upload cap
# CHAT_MESSAGE_MAX_CHARS=4000
# CHAT_HISTORY_MAX_ENTRIES=40

# ── Paths (all optional) ──
# UPLOAD_FOLDER=./uploads
# STORAGE_FOLDER=./storage
# SESSION_FILE_DIR=./flask_session
