# ─────────────────────────────────────────────────────────────────
# TestFortge — sample environment file
# Copy to `.env` and fill in real values for your deployment.
# ─────────────────────────────────────────────────────────────────

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to "1" while developing so an ephemeral key is minted automatically.
FLASK_DEBUG=1

# Set to "1" if the app runs behind HTTPS (production).
# Enables Secure cookies and strict CSRF SSL.
BEHIND_HTTPS=0

# ── HTTP Basic Auth gate (recommended when the app is reachable
#    beyond localhost — LAN, VPN, tunnel, or public deploy) ──
# When BOTH user and password are set every request (except the
# allow-listed paths below) requires `Authorization: Basic <b64>`.
# Leave them empty for purely-local development with no auth.
TESTFORTGE_BASIC_USER=
TESTFORTGE_BASIC_PASSWORD=
# Comma-separated list of paths/prefixes that bypass the gate.
# Default: /healthz,/readyz so liveness + readiness probes keep working.
# TESTFORTGE_BASIC_PUBLIC_PATHS=/healthz,/readyz

# ── Network bind (only consulted by `python app.py`; gunicorn /
#    docker-compose use their own bind config) ──
# 127.0.0.1 = loopback only (default, safest)
# 0.0.0.0   = expose on every network interface — REQUIRES
#             TESTFORTGE_BASIC_USER/PASSWORD to be set.
# TESTFORTGE_HOST=127.0.0.1

# ── Limits (all optional, defaults are sane) ──
# MAX_CONTENT_LENGTH=67108864          # 64 MB upload cap
# CHAT_MESSAGE_MAX_CHARS=4000
# CHAT_HISTORY_MAX_ENTRIES=40

# ── Tedgie AI chatbot (Anthropic Claude) ──
# Leave empty to run Tedgie in pure rule-based mode (no network calls).
# When set, Tedgie will use Claude for free-form questions and fall back
# to the rule-based dispatcher on any failure.
ANTHROPIC_API_KEY=
# ANTHROPIC_MAX_TOKENS=600

# ── Which model does which job (engine/llm_models.py — E0.8) ──
# Models are chosen from the *kind of work*, not per call site:
#   authoring / analysis / vision → sonnet   (claude-sonnet-5)
#   segmentation                  → haiku    (claude-haiku-4-5-20251001)
#   consult (Tedgie)              → sonnet   — moves to haiku once the
#                                   E6.7 eval harness can measure quality
#
# Repoint a whole tier:
# ANTHROPIC_MODEL_SONNET=claude-sonnet-5
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
# Move one kind to another tier (this is the ~45% cost lever):
# LLM_CONSULT_TIER=haiku
# Pin one kind to an exact model:
# LLM_MODEL_FOR_AUTHORING=claude-sonnet-5
#
# Legacy global pin. Still honoured so existing deploys keep working, but
# it overrides EVERY kind and disables routing — the app warns at boot.
# ANTHROPIC_MODEL=

# ── LLM cost controls (E0.7 / E0.9) ──
# Monthly ceiling in USD on what ONE organisation may spend on the
# platform's key. 0 = unlimited. An org using its own key (BYOK) is
# exempt. Over the cap, generation falls back to the deterministic
# engine rather than failing.
# LLM_ORG_BUDGET_USD=5
#
# Encrypts each organisation's own Anthropic key at rest. Without it,
# BYOK is off: storing a customer key is refused rather than stored in
# the clear. Accepts a Fernet key or any random string of >= 32 chars.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it SEPARATE from SECRET_KEY — rotating the cookie-signing key
# would otherwise make every stored customer key undecryptable.
#
# Declared once, in the docker-compose block at the end of this file:
# E8.3 made it required for a compose deployment (storage credentials
# take the same path as BYOK keys), and two entries for one variable in
# a sample env file is one entry too many.

# ── Where a project's work actually lives (engine/workspace.py — E3.2) ──
# Off: the Flask session answers first and Postgres second — today's
# behaviour, and why two people cannot share a project.
# On:  Postgres is the source of truth and the session is ignored for
#      artefacts. Required before EDITORS_ENABLED or DASHBOARD_V2 do
#      anything at all (see docs/plans/adr/0001).
# WORKSPACE_DB_FIRST=0

# ── Google sign-in (engine/oauth.py — E1.4) ──
# Both required, or the button is hidden rather than rendered to fail at
# the callback. From console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client ID (type: Web application).
#
# Register this exact redirect URI on the client:
#   https://<your-host>/auth/google/callback
#
# Google sign-in is a sign-in mechanism, not a way around invite-only
# registration: an address with no account and no live invitation is
# refused. An address is only linked to an existing account when Google
# asserts email_verified — otherwise anyone could add a victim's address
# to their own Google account and sign in as them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Paths (all optional) ──
# UPLOAD_FOLDER=./uploads
# STORAGE_FOLDER=./storage
# SESSION_FILE_DIR=./flask_session
# STORAGE_ROOT=./storage                # run artefacts, bug attachments —
                                        # point it at a mounted volume to
                                        # keep them off the container disk

# ── Logging ──
# LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text                       # "text" for dev, "json" for containers

# ── Job queue (async /automation and /estimation endpoints) ──
# JOB_QUEUE_WORKERS=2                   # ThreadPoolExecutor width
# JOB_RETENTION_SECONDS=3600            # how long finished jobs stay queryable
# MAX_CONCURRENT_JOBS_PER_SESSION=3     # per-user concurrency cap, 429 on overflow

# ── Automation module (TS + Playwright + Allure) ──
# The shared secret a local or CI run presents to POST allure-results back
# to /automation/allure-results. UNSET MEANS THE ENDPOINT IS OFF — an
# unauthenticated ingest endpoint is one anyone can write run history into.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOMATION_INGEST_TOKEN=

# ── Docker compose / standalone ──
# TESTFORTGE_PORT=5000                  # host port to publish

# ─────────────────────────────────────────────────────────────────
# Self-hosting with docker-compose (E8.6)
#
# The four below have no safe default and `docker-compose.yml` refuses
# to start without them. See docs/runbooks/self-hosting.md §2 for a
# one-liner that generates all of them at once.
#
# Only needed for `docker compose`. Running `python app.py` locally with
# FLASK_DEBUG=1 needs none of them.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL, created by the `db` service. The app's DATABASE_URL is
# assembled from these, so the password lives in exactly one place.
POSTGRES_USER=testfortge
POSTGRES_PASSWORD=
POSTGRES_DB=testfortge

# Encrypts each team's own secrets at rest: its Anthropic API key (E0.9)
# and its storage credentials (E8.3). Without it the app runs and refuses
# to store either — the correct refusal, and a confusing first impression.
#
# ROTATING THIS MAKES EVERYTHING STORED UNDER IT UNREADABLE. It is a
# separate variable from SECRET_KEY on purpose: rotating SECRET_KEY to
# sign everyone out is a normal thing to do, and it must not also destroy
# stored API keys.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TESTFORTGE_ENCRYPTION_KEY=

# Object storage. In the compose topology these are MinIO's own root
# credentials, and the app uses the same pair as its S3 credentials.
# Pointing at Cloudflare R2, AWS S3, Backblaze B2 or Wasabi instead is
# the same four values with a different endpoint (ADR 0002 §4.1).
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=http://storage:9000
STORAGE_S3_BUCKET=testfortge
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Plain HTTP on the compose network. An explicit scheme in the endpoint
# above wins over this flag — see engine/storage.py.
STORAGE_S3_SECURE=0

# Sessions in Postgres, so a sign-in survives an upgrade. "filesystem"
# is the legacy default and signs everyone out on every container
# replacement.
SESSION_BACKEND=db

# Real accounts (E1/E2). Turn both on, create your first account, and
# only THEN set BASIC_GATE_ENABLED=0 — see the runbook §4.
AUTH_ENABLED=0
ORG_MODE=0
BASIC_GATE_ENABLED=1

# Host port, memory ceiling, and whether Chromium runs at all.
TESTFORTGE_PORT=5000
TESTFORTGE_MEMORY_LIMIT=2g
TESTFORTGE_BROWSER_ENABLED=1
MINIO_CONSOLE_PORT=9001

# ── Scheduled backups (E8.4) ──────────────────────────────────────
# Authenticates POST /api/backup/run, which walks every project and
# writes a bundle to the configured storage. UNSET MEANS THE ENDPOINT
# REFUSES — an open endpoint that writes to storage on every project is
# a way to fill somebody's bucket for them.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value as a repository secret named BACKUP_TOKEN, and
# BACKUP_URL as a repository variable, for .github/workflows/backup.yml.
BACKUP_TOKEN=
# Bundles kept per project. Older ones are pruned on each new backup, so
# an unattended weekly job cannot fill the bucket.
BACKUP_KEEP=7
