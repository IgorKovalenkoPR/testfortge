__pycache__/
*.pyc
*.pyo
flask_session/
uploads/
storage/
# Local SQLite/SQLAlchemy fallback DBs — Postgres is the prod backend.
*.db
*.sqlite3
.env
*.egg-info/
dist/
build/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE / editor
.idea/
.vscode/
*.swp

# Virtual environments
venv/
.venv/
env/

# Large bundled artifact (keep as release asset instead)
ui_audit_tool.zip

# Claude Code — user-local state (keep launch.json shareable)
.claude/settings.local.json

# Runtime logs from `python app.py`
flask.log
*.log

# Tunnel binaries + tunnel logs in `tools/` — cloudflared.exe is 66 MB
# and tunnel session logs are local-only. Drop the binary as a release
# asset / download on demand instead of committing. We use the
# pattern `tools/*` (not `tools/`) so explicit re-includes below can
# whitelist individual scripts.
tools/*
!tools/build_istqb_corpus.py

# Temporary DOCX build helpers and generated artefacts
_build_requirements_docx.js
build_requirements_docx.js
TestFortge_Requirements*.docx
TestFortge_Requirements_*.docx

# Ephemeral commit-message scratch file (used by tooling that can't
# pipe heredocs through `git commit -m`).
.git-commit-msg.tmp
